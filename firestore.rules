rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === UTILISATEURS ===
    match /users/{userId} {
      // Les rôles sont gérés depuis la console/Admin SDK, jamais par le navigateur.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'photoURL'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // === PRODUITS ===
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === VARIANTES DES PRODUITS ===
    match /products/{productId}/variants/{variantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === CATEGORIES ===
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === COMMANDES ===
    match /orders/{orderId} {
      // Une commande publique peut être créée, mais sa structure et son statut
      // initial sont contrôlés pour limiter les abus côté client.
      allow create: if request.resource.data.keys().hasOnly([
          'customerName', 'customerPhone', 'customerAddress', 'deliveryMethod',
          'deliveryFee', 'subTotal', 'total', 'totalFormatted', 'status',
          'createdAt', 'date', 'items'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 8
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.customerAddress is string
        && request.resource.data.customerAddress.size() <= 500
        && request.resource.data.deliveryMethod is string
        && request.resource.data.deliveryMethod.size() <= 120
        && request.resource.data.deliveryFee is number
        && request.resource.data.deliveryFee >= 0
        && request.resource.data.subTotal is number
        && request.resource.data.subTotal >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= request.resource.data.subTotal
        && request.resource.data.total <= 100000000
        && request.resource.data.totalFormatted is string
        && request.resource.data.totalFormatted.size() <= 60
        && request.resource.data.status == 'En attente'
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 30
        && request.resource.data.createdAt is timestamp
        && request.resource.data.date is timestamp;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // === DEMANDES D'ÉCHANGE ===
    match /exchanges/{exchangeId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // === BANNIERES ===
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === PROMOTIONS ===
    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === VENTES FLASH ===
    match /flashSales/{flashId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === INVENTORY & STOCK ===
    match /inventory/{itemId} {
      // Transitional: the public catalogue currently reads availability from
      // this collection. Move public availability to a separate projection
      // before changing this to isAdmin(), otherwise the storefront breaks.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /stock/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === PARAMÈTRES DU SITE ===
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // === DETTES ===
    match /debts/{debtId} {
      allow read, write: if isAdmin();
    }

    // === CLIENTS (dérivés des commandes) ===
    // Il n'est pas nécessaire d'avoir des règles pour une collection qui n'existe pas.
    // Les données clients sont lues depuis la collection 'orders' par le backend admin.

    // === UTILITY FUNCTION ===
    function isAdmin() {
      // Vérifie si l'utilisateur est authentifié et si son document dans la collection 'users' a le rôle 'admin'.
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
